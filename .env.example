# Template only. Add real values to the Hostinger Web App environment variables,
# never commit a populated .env file or store uploads in the deployment directory.
NODE_ENV="development"
PORT="3000"
PUBLIC_ORIGIN="http://localhost:3000"
TRUST_PROXY="1"
DB_HOST="127.0.0.1"
DB_PORT="3306"
DB_NAME="replace-with-new-database-name"
DB_USER="replace-with-new-database-user"
DB_PASSWORD="replace-in-hostinger-only"
UPLOAD_ROOT="/absolute/path/outside-the-deployment-directory/media"

# Optional, only for the first boot after importing server/db/schema.sql.
# Remove both variables after the first administrator is created.
# INITIAL_ADMIN_USERNAME="choose-a-username"
# INITIAL_ADMIN_PASSWORD="choose-a-unique-password-of-at-least-12-characters"
